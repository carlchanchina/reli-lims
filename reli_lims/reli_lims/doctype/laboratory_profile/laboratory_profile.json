    {"fieldname": "draft_revision", "label": "Draft Revision", "fieldtype": "Int", "read_only": 1},
    {"fieldname": "published_revision", "label": "Published Revision", "fieldtype": "Int", "read_only": 1},
    {"fieldname": "submitted_at", "label": "Submitted At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "reviewed_at", "label": "Reviewed At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "reviewed_by", "label": "Reviewed By", "fieldtype": "Link", "options": "User", "read_only": 1},
    {"fieldname": "review_note", "label": "Review Note", "fieldtype": "Small Text", "read_only": 1}
