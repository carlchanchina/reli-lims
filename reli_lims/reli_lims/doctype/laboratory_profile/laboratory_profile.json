    {"fieldname": "review_status", "label": "Review Status", "fieldtype": "Select", "options": "Draft\nPending\nApproved\nRejected", "default": "Draft", "read_only": 1, "in_list_view": 1},
    {"fieldname": "draft_json", "label": "Submitted Profile", "fieldtype": "JSON", "read_only": 1},
