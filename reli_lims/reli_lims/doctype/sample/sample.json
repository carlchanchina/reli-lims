{
  "actions": [],
  "allow_bulk_edit": 1,
  "allow_rename": 1,
  "autoname": "format:SMP-{#####}",
  "doctype": "DocType",
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": [
    "test_request",
    "project",
    "customer",
    "product_name",
    "model",
    "serial_no",
    "quantity",
    "dimensions",
    "weight_kg",
    "received_date",
    "received_by",
    "status",
    "condition",
    "storage_location",
    "notes",
    "request_sample_row"
  ],
  "fields": [
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "项目",
      "options": "Project",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "客户",
      "options": "Customer",
      "read_only": 1
    },
    {
      "fieldname": "product_name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "产品名称"
    },
    {
      "fieldname": "model",
      "fieldtype": "Data",
      "label": "型号"
    },
    {
      "fieldname": "serial_no",
      "fieldtype": "Data",
      "label": "序列号"
    },
    {
      "default": "1",
      "fieldname": "quantity",
      "fieldtype": "Float",
      "label": "数量",
      "reqd": 1
    },
    {
      "default": "Today",
      "fieldname": "received_date",
      "fieldtype": "Date",
      "label": "收样日期",
      "reqd": 1
    },
    {
      "fieldname": "received_by",
      "fieldtype": "Link",
      "label": "收样人",
      "options": "User"
    },
    {
      "fieldname": "condition",
      "fieldtype": "Small Text",
      "label": "样品状态说明"
    },
    {
      "default": "Received",
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "状态",
      "options": "Received\nTesting\nCompleted\nRetained\nReturned\nDisposed",
      "reqd": 1
    },
    {
      "fieldname": "storage_location",
      "fieldtype": "Data",
      "label": "存放位置"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "备注"
    },
    {
      "fieldname": "test_request",
      "label": "检测委托单",
      "fieldtype": "Link",
      "options": "Test Request",
      "read_only": 1
    },
    {
      "fieldname": "request_sample_row",
      "label": "来源委托样品行",
      "fieldtype": "Data",
      "read_only": 1,
      "unique": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "dimensions",
      "label": "体积／外形尺寸",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "weight_kg",
      "label": "重量（kg）",
      "fieldtype": "Float",
      "precision": "3"
    }
  ],
  "grid_page_length": 50,
  "index_web_pages_for_search": 1,
  "links": [],
  "module": "Reli LIMS",
  "name": "Sample",
  "naming_rule": "Expression (old style)",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Lab Manager",
      "share": 1,
      "write": 1
    },
    {
      "create": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Lab Engineer",
      "share": 1,
      "write": 1
    },
    {
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Lab Reviewer",
      "share": 1
    }
  ],
  "row_format": "Dynamic",
  "rows_threshold_for_grid_search": 20,
  "sort_field": "modified",
  "sort_order": "DESC",
  "states": [],
  "title_field": "product_name",
  "track_changes": 1
}
