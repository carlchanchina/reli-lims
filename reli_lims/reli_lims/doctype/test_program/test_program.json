{
  "actions": [],
  "allow_bulk_edit": 1,
  "allow_rename": 1,
  "autoname": "format:PRG-{#####}",
  "doctype": "DocType",
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": [
    "project",
    "customer",
    "title",
    "responsible_engineer",
    "planned_start",
    "planned_end",
    "status",
    "samples",
    "items",
    "sample_assignments",
    "notes",
    "test_request"
  ],
  "fields": [
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "项目",
      "options": "Project",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "客户",
      "options": "Customer",
      "read_only": 1
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "方案名称"
    },
    {
      "fieldname": "responsible_engineer",
      "fieldtype": "Link",
      "label": "负责工程师",
      "options": "User"
    },
    {
      "fieldname": "planned_start",
      "fieldtype": "Date",
      "label": "计划开始时间"
    },
    {
      "fieldname": "planned_end",
      "fieldtype": "Date",
      "label": "计划结束时间"
    },
    {
      "default": "Draft",
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "状态",
      "options": "Draft\nApproved\nRunning\nCompleted\nCancelled",
      "reqd": 1
    },
    {
      "fieldname": "samples",
      "fieldtype": "Table",
      "label": "样品",
      "options": "Test Program Sample",
      "reqd": 1
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "检测项目",
      "options": "Test Program Item",
      "reqd": 1
    },
    {
      "description": "每行关联一个检测项目和一个样品；每个检测项目至少关联一个样品。",
      "fieldname": "sample_assignments",
      "fieldtype": "Table",
      "label": "项目适用样品",
      "options": "Test Program Item Sample",
      "reqd": 1,
      "hidden": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "备注"
    },
    {
      "fieldname": "test_request",
      "label": "检测委托单",
      "fieldtype": "Link",
      "options": "Test Request",
      "read_only": 1,
      "unique": 1,
      "no_copy": 1
    }
  ],
  "grid_page_length": 50,
  "index_web_pages_for_search": 1,
  "links": [],
  "module": "Reli LIMS",
  "name": "Test Program",
  "naming_rule": "Expression (old style)",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Lab Manager",
      "share": 1,
      "write": 1
    },
    {
      "create": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Lab Engineer",
      "share": 1,
      "write": 1
    },
    {
      "create": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Lab Reviewer",
      "share": 1,
      "write": 1
    }
  ],
  "row_format": "Dynamic",
  "rows_threshold_for_grid_search": 20,
  "sort_field": "creation",
  "sort_order": "DESC",
  "states": [],
  "track_changes": 1
}
