    {
      "default": "V1.0",
      "fieldname": "version",
      "fieldtype": "Data",
      "label": "报告版本"
    },
    {
      "default": "Draft",
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "状态",
      "options": "Draft\nReview\nApproved\nIssued",
      "reqd": 1
    },
    {
      "fieldname": "issued_date",
      "fieldtype": "Date",
      "label": "签发日期",
      "read_only": 1
    },
    {
      "fieldname": "pdf_file",
      "fieldtype": "Attach",
      "label": "最终报告文件"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "备注"
    },
    {
      "fieldname": "test_request",
      "label": "检测委托单",
      "fieldtype": "Link",
      "options": "Test Request",
      "read_only": 1
    }
  ],
  "grid_page_length": 50,
  "index_web_pages_for_search": 1,
