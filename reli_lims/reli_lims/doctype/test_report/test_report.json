{
  "actions": [],
  "allow_bulk_edit": 1,
  "allow_rename": 1,
  "autoname": "format:RPT-{#####}",
  "doctype": "DocType",
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": [
    "project",
    "test_program",
    "customer",
    "engineer",
    "reviewer",
    "approver",
    "test_start",
    "test_end",
    "overall_conclusion",
    "version",
    "status",
    "issued_date",
    "pdf_file",
    "notes",
    "test_request"
  ],
  "fields": [
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "项目",
      "options": "Project",
      "reqd": 1
    },
    {
      "fieldname": "test_program",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "试验方案",
      "options": "Test Program",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "客户",
      "options": "Customer",
      "read_only": 1
    },
    {
      "fieldname": "engineer",
      "fieldtype": "Link",
      "label": "编制人",
      "options": "User"
    },
    {
      "fieldname": "reviewer",
      "fieldtype": "Link",
      "label": "审核人",
      "options": "User"
    },
    {
      "fieldname": "approver",
      "fieldtype": "Link",
      "label": "批准人",
      "options": "User",
      "hidden": 1
    },
    {
      "fieldname": "test_start",
      "fieldtype": "Date",
      "label": "检测开始时间",
      "hidden": 1
    },
    {
      "fieldname": "test_end",
      "fieldtype": "Date",
      "label": "检测结束时间",
      "hidden": 1
    },
    {
      "fieldname": "overall_conclusion",
      "fieldtype": "Data",
      "label": "总体结论"
