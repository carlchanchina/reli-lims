{
  "actions": [],
  "autoname": "format:REQ-{#####}",
  "doctype": "DocType",
  "field_order": [
    "basic",
    "title",
    "request_date",
    "delivery_date",
    "customer",
    "contact_person",
    "contact_phone",
    "contact_email",
    "notes",
    "commercial_source",
    "quotation",
    "sales_order",
    "sample_info",
    "samples",
    "test_info",
    "items",
    "requirements",
    "result_judgment",
    "judgment_basis",
    "subcontract_consent",
    "sample_return",
    "sample_handling_notes",
    "report_requirements",
    "system_details",
    "company",
    "applicant_address",
    "payer_same_as_customer",
    "payer_customer",
    "report_same_as_customer",
    "report_company",
    "report_address",
    "report_language",
    "report_copies",
    "report_format",
    "test_purpose",
    "photos",
    "sample_assignments",
    "fixture_required",
    "fixture_provider",
    "test_flow_notes",
    "method_choice_consent",
    "customer_confirmation_notes",
    "engineering_review_notes",
    "project",
    "confirmed_by",
    "confirmed_on",
    "business_stage",
    "sample_summary",
    "test_summary",
    "responsible_engineer",
    "overdue_status"
  ],
  "fields": [
    {
      "fieldname": "basic",
      "fieldtype": "Section Break",
      "label": "基本信息"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "委托名称",
      "reqd": 1
    },
    {
      "default": "Today",
      "fieldname": "request_date",
      "fieldtype": "Date",
      "label": "委托日期",
      "reqd": 1
    },
    {
      "fieldname": "delivery_date",
      "fieldtype": "Date",
      "in_list_view": 1,
      "label": "要求完成日期",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "委托单位",
      "options": "Customer",
      "reqd": 1
    },
    {
      "fieldname": "contact_person",
      "fieldtype": "Data",
      "label": "联系人"
    },
    {
      "fieldname": "contact_phone",
      "fieldtype": "Data",
      "label": "联系电话",
      "options": "Phone"
    },
    {
      "fieldname": "contact_email",
      "fieldtype": "Data",
      "label": "联系邮箱",
      "options": "Email"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "备注"
    },
    {
      "fieldname": "sample_info",
      "fieldtype": "Section Break",
      "label": "样品信息"
    },
    {
      "fieldname": "samples",
      "fieldtype": "Table",
      "label": "委托样品",
      "options": "Test Request Sample",
      "reqd": 1,
      "description": "填写产品名称、型号、尺寸和重量；实验室样品编号在实际收样后生成。"
    },
    {
      "fieldname": "test_info",
      "fieldtype": "Section Break",
      "label": "检测项目"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "检测项目明细",
      "options": "Test Request Item",
      "reqd": 1,
      "description": "按行顺序安排检测，打开试验项目行即可选择适用样品。"
    },
    {
      "fieldname": "requirements",
      "fieldtype": "Section Break",
      "label": "客户特殊要求"
    },
    {
      "fieldname": "result_judgment",
      "fieldtype": "Select",
      "label": "是否需要结果判定",
      "options": "\nRequired\nNot Required"
    },
    {
      "fieldname": "judgment_basis",
      "fieldtype": "Small Text",
      "label": "判定依据",
      "depends_on": "eval:doc.result_judgment=='Required'",
      "mandatory_depends_on": "eval:doc.result_judgment==\"Required\""
    },
    {
      "fieldname": "subcontract_consent",
      "fieldtype": "Select",
      "label": "是否接受分包检测",
      "options": "\nYes\nNo"
    },
    {
      "fieldname": "sample_return",
      "fieldtype": "Select",
      "label": "检后样品处理方式",
      "options": "\nReturn by Courier\nSelf Pickup\nRetain 30 Days then Dispose"
    },
    {
      "fieldname": "sample_handling_notes",
      "fieldtype": "Small Text",
      "label": "样品处理补充说明"
    },
    {
      "fieldname": "report_requirements",
      "fieldtype": "Small Text",
      "label": "报告特殊要求"
    },
    {
      "fieldname": "system_details",
      "fieldtype": "Section Break",
      "label": "系统信息",
      "collapsible": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "公司",
      "options": "Company",
      "reqd": 1,
      "hidden": 1
    },
    {
      "fieldname": "applicant_address",
      "fieldtype": "Small Text",
      "label": "委托方地址",
      "hidden": 1
    },
    {
      "fieldname": "payer_same_as_customer",
      "fieldtype": "Check",
      "label": "发票抬头同委托单位",
      "default": "1",
      "hidden": 1
    },
    {
      "fieldname": "payer_customer",
      "fieldtype": "Link",
      "label": "发票抬头客户",
      "options": "Customer",
      "depends_on": "eval:!doc.payer_same_as_customer",
      "mandatory_depends_on": "eval:!doc.payer_same_as_customer",
      "hidden": 1
    },
    {
      "fieldname": "report_same_as_customer",
      "fieldtype": "Check",
      "label": "报告抬头同委托单位",
      "default": "1",
      "hidden": 1
    },
    {
      "fieldname": "report_company",
      "fieldtype": "Data",
      "label": "报告抬头单位",
      "depends_on": "eval:!doc.report_same_as_customer",
      "mandatory_depends_on": "eval:!doc.report_same_as_customer",
      "hidden": 1
    },
    {
      "fieldname": "report_address",
      "fieldtype": "Small Text",
      "label": "报告抬头地址",
      "depends_on": "eval:!doc.report_same_as_customer",
      "mandatory_depends_on": "eval:!doc.report_same_as_customer",
      "hidden": 1
    },
    {
      "default": "Chinese",
      "fieldname": "report_language",
      "fieldtype": "Data",
      "label": "报告语言",
      "hidden": 1
    },
    {
      "default": "1",
      "fieldname": "report_copies",
      "fieldtype": "Int",
      "label": "报告份数",
      "reqd": 0,
      "hidden": 1
    },
    {
      "fieldname": "report_format",
      "fieldtype": "Select",
      "label": "报告形式",
      "options": "\nElectronic\nPaper\nElectronic and Paper",
      "hidden": 1
    },
    {
      "fieldname": "test_purpose",
      "fieldtype": "Select",
      "label": "检测目的",
      "options": "\nCustomer Requirement\nInternal Use\nOther",
      "hidden": 1
    },
    {
      "fieldname": "photos",
      "fieldtype": "Table",
      "label": "样品照片",
      "options": "Test Request Photo",
      "description": "先保存草稿，再上传私有照片并选择所属样品编号。",
      "hidden": 1
    },
    {
      "fieldname": "sample_assignments",
      "fieldtype": "Table",
      "label": "检测项目适用样品",
      "options": "Test Request Item Sample",
      "reqd": 1,
      "hidden": 1
    },
    {
      "fieldname": "fixture_required",
      "fieldtype": "Select",
      "label": "是否需要夹具",
      "options": "\nYes\nNo",
      "hidden": 1
    },
    {
      "fieldname": "fixture_provider",
      "fieldtype": "Select",
      "label": "夹具提供方",
      "options": "\nCustomer\nLaboratory",
      "depends_on": "eval:doc.fixture_required==\"Yes\"",
      "mandatory_depends_on": "eval:doc.fixture_required==\"Yes\"",
      "hidden": 1
    },
    {
      "fieldname": "test_flow_notes",
      "fieldtype": "Small Text",
      "label": "检测顺序说明",
      "hidden": 1
    },
    {
      "fieldname": "method_choice_consent",
      "fieldtype": "Select",
      "label": "是否接受实验室选择检测方法",
      "options": "\nYes\nNo",
      "hidden": 1
    },
    {
      "fieldname": "customer_confirmation_notes",
      "fieldtype": "Small Text",
      "label": "客户确认记录",
      "hidden": 1
    },
    {
      "fieldname": "engineering_review_notes",
      "fieldtype": "Small Text",
      "label": "工程确认记录",
      "hidden": 1
    },
    {
      "allow_on_submit": 1,
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "项目",
      "options": "Project",
      "read_only": 1,
      "hidden": 0
    },
    {
      "allow_on_submit": 1,
      "fieldname": "confirmed_by",
      "fieldtype": "Link",
      "label": "确认人",
      "options": "User",
      "read_only": 1,
      "hidden": 0
    },
    {
      "allow_on_submit": 1,
      "fieldname": "confirmed_on",
      "fieldtype": "Datetime",
      "label": "确认时间",
      "read_only": 1,
      "hidden": 0
    },
    {
      "fieldname": "business_stage",
      "fieldtype": "Select",
      "label": "业务阶段",
      "read_only": 1,
      "allow_on_submit": 1,
      "no_copy": 1,
      "in_list_view": 1,
      "options": "待确认\n待收样\n已收样\n待试验\n试验中\n待报告\n报告审核\n已完成",
      "default": "待确认"
    },
    {
      "fieldname": "sample_summary",
      "fieldtype": "Data",
      "label": "样品名称",
      "read_only": 1,
      "allow_on_submit": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "test_summary",
      "fieldtype": "Data",
      "label": "主要检测项目",
      "read_only": 1,
      "allow_on_submit": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "responsible_engineer",
      "fieldtype": "Link",
      "label": "负责人",
      "options": "User"
    },
    {
      "fieldname": "overdue_status",
      "fieldtype": "Data",
      "label": "超期标识",
      "read_only": 1,
      "allow_on_submit": 1,
      "no_copy": 1
    },
    {
      "fieldname": "commercial_source",
      "fieldtype": "Section Break",
      "label": "报价与订单（可选）",
      "collapsible": 1
    },
    {
      "fieldname": "quotation",
      "fieldtype": "Link",
      "options": "Quotation",
      "label": "关联报价单",
      "no_copy": 1,
      "description": "无报价单也可手工创建委托；不自动复制商品行作为样品或检测项目。"
    },
    {
      "fieldname": "sales_order",
      "fieldtype": "Link",
      "options": "Sales Order",
      "label": "关联销售订单",
      "no_copy": 1
    }
  ],
  "is_submittable": 1,
  "links": [],
  "module": "Reli LIMS",
  "name": "Test Request",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "print": 1,
      "read": 1,
      "role": "Lab Manager",
      "submit": 1,
      "write": 1
    },
    {
      "create": 1,
      "print": 1,
      "read": 1,
      "role": "Lab Engineer",
      "write": 1
    },
    {
      "print": 1,
      "read": 1,
      "role": "Lab Reviewer"
    }
  ],
  "states": [],
  "title_field": "title",
  "track_changes": 1
}
